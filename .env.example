# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://statusping:CHANGE_ME@localhost:5432/statusping
# Password for the seed_demo users. Pick your own.
DEMO_PASSWORD=CHANGE_ME
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
# Throttling (DRF rate strings: N/sec, N/min, N/hour, N/day)
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REFRESH_RATE=10/min
THROTTLE_REGISTER_RATE=5/hour
THROTTLE_WRITE_RATE=60/min
# Number of reverse proxies in front of the app (0 locally)
NUM_PROXIES=0

# Monitors and checks
MONITORS_PER_ORG=20
MONITOR_DEFAULT_INTERVAL_SECONDS=60
MONITOR_DEFAULT_TIMEOUT_SECONDS=5
CHECK_USER_AGENT=StatusPing/0.2 (+https://github.com/MhBaigtw/statusping)

# Worker, scheduler and job queue
WORKER_THREADS=4
WORKER_POLL_SECONDS=1
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_HEARTBEAT_STALE_SECONDS=60
SCHEDULER_INTERVAL_SECONDS=10
JOB_LEASE_SECONDS=60
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_RETRY_MAX_SECONDS=900
JOB_SUCCEEDED_RETENTION_DAYS=7

# Alerts
ALERT_MAX_ATTEMPTS=5
ALERT_TIMEOUT_SECONDS=5

# DEV ONLY: let monitors and webhooks target 127.0.0.1 / ::1 (used by scripts/e2e.py).
# Ignored unless DEBUG is True; prod settings force it off.
SSRF_ALLOW_LOOPBACK=False

# Public status page
STATUS_PAGE_CACHE_SECONDS=30
THROTTLE_STATUS_PAGE_RATE=120/min
