# /etc/statusping/statusping.env (option (b), Oracle VM). chmod 600, owned by root.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME
DATABASE_URL=postgres://statusping:CHANGE_ME@127.0.0.1:5432/statusping
DB_SSLMODE=disable          # local Postgres on the same VM: no TLS needed over loopback
ALLOWED_HOSTS=status.example.com
CSRF_TRUSTED_ORIGINS=https://status.example.com
NUM_PROXIES=1               # Caddy on the same host; verify with forged X-Forwarded-For
WEB_CONCURRENCY=2
DEMO_PASSWORD=
