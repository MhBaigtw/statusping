# Option (b): job worker + scheduler. /etc/systemd/system/statusping-worker.service
[Unit]
Description=StatusPing worker (job threads + scheduler)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=statusping
WorkingDirectory=/opt/statusping
EnvironmentFile=/etc/statusping/statusping.env
ExecStart=/opt/statusping/.venv/bin/python manage.py run_worker --threads 4
# SIGTERM = graceful shutdown (stop claiming, finish in-flight jobs for up to 30 s)
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
